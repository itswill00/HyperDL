#!/system/bin/sh

PID_FILE="/data/local/tmp/hyperdl_clip.pid"
LAST_CLIP_FILE="/data/local/tmp/hyperdl_last_clip.txt"
MODDIR="${0%/*}/.."

find_jar() {
    for j in \
        /data/adb/modules/hyperdl/bin/clip.jar \
        /data/adb/modules/hyperdl/system/bin/clip.jar \
        /data/adb/modules_update/hyperdl/bin/clip.jar \
        /data/adb/modules_update/hyperdl/system/bin/clip.jar \
        /data/adb/hyperdl/clip.jar \
        /system/bin/clip.jar \
        "$MODDIR/bin/clip.jar" \
        "$MODDIR/system/bin/clip.jar"; do
        if [ -f "$j" ]; then
            echo "$j"
            return 0
        fi
    done
    echo ""
}

find_bridge() {
    for b in \
        /data/adb/modules/hyperdl/bin/libhyperdl.so \
        /data/adb/modules/hyperdl/system/bin/libhyperdl.so \
        /data/adb/modules_update/hyperdl/bin/libhyperdl.so \
        /data/adb/modules_update/hyperdl/system/bin/libhyperdl.so \
        /system/bin/libhyperdl.so \
        "$MODDIR/bin/libhyperdl.so" \
        "$MODDIR/system/bin/libhyperdl.so"; do
        if [ -x "$b" ]; then
            echo "$b"
            return 0
        fi
    done
    echo ""
}

get_clipboard() {
    JAR="$(find_jar)"
    if [ -n "$JAR" ]; then
        ANDROID_ROOT=/system ANDROID_DATA=/data CLASSPATH="$JAR" app_process /system/bin Clip 2>/dev/null
    fi
}

is_screen_on() {
  local b=""
  for f in /sys/class/backlight/*/brightness /sys/class/leds/lcd-backlight/brightness /sys/class/leds/wled/brightness; do
    if [ -r "$f" ]; then b="$(cat "$f" 2>/dev/null)"; [ -n "$b" ] && [ "$b" -gt 0 ] 2>/dev/null && return 0; return 1; fi
  done
  return 0
}

case "$1" in
  start)
    if [ -f "$PID_FILE" ]; then
      OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
      if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        exit 0
      fi
    fi

    (
      LAST_PROCESSED_URL=""
      if [ -f "$LAST_CLIP_FILE" ]; then
        LAST_PROCESSED_URL="$(cat "$LAST_CLIP_FILE" 2>/dev/null | tr -d ' \r\n')"
      fi

      IDLE_TICKS=0
      while true; do
        if [ ! -f /data/adb/hyperdl/autodl.enabled ]; then
          break
        fi
        if ! is_screen_on; then
          sleep 45
          continue
        fi
        if [ "$IDLE_TICKS" -ge 30 ]; then
          sleep 8
        elif [ "$IDLE_TICKS" -ge 10 ]; then
          sleep 6
        else
          sleep 4
        fi

        CLIP="$(get_clipboard)"

        if [ -z "$CLIP" ]; then
          IDLE_TICKS=$((IDLE_TICKS + 1))
        else
          IDLE_TICKS=0
        fi
        if [ -n "$CLIP" ]; then
          LOW_CLIP="$(echo "$CLIP" | tr '[:upper:]' '[:lower:]')"
          MATCHED=false
          case "$LOW_CLIP" in
            *tiktok.com*|*douyin.com*|*instagram.com*|*instagr.am*|*twitter.com*|*x.com*|*t.co*|*youtu.be*|*youtube.com*|*facebook.com*|*fb.watch*|*fb.com*|*pinterest.com*|*pin.it*|*reddit.com*|*redd.it*|*threads.net*|*streamable.com*|*bilibili.com*|*b23.tv*|*bsky.app*|*twitch.tv*)
              MATCHED=true
              ;;
            *)
              if [ -f /data/adb/hyperdl/vault.enabled ] && [ -f /data/adb/hyperdl/vault_domains.conf ]; then
                while IFS= read -r vdom || [ -n "$vdom" ]; do
                  vdom="$(echo "$vdom" | tr -d ' \r\n')"
                  [ -z "$vdom" ] && continue
                  case "$LOW_CLIP" in
                    *"$vdom"*)
                      MATCHED=true
                      break
                      ;;
                  esac
                done < /data/adb/hyperdl/vault_domains.conf
              fi
              ;;
          esac

          if [ "$MATCHED" = "true" ]; then
            CLEAN_URL="$(echo "$CLIP" | grep -oE 'https?://[^[:space:]<>"]+' | head -n 1)"
            [ -z "$CLEAN_URL" ] && CLEAN_URL="$CLIP"

            LAST_FILE_URL=""
            if [ -f "$LAST_CLIP_FILE" ]; then
              LAST_FILE_URL="$(cat "$LAST_CLIP_FILE" 2>/dev/null | tr -d ' \r\n')"
            fi

            if [ "$CLEAN_URL" != "$LAST_PROCESSED_URL" ] && [ "$CLEAN_URL" != "$LAST_FILE_URL" ]; then
              LAST_PROCESSED_URL="$CLEAN_URL"
              echo "$CLEAN_URL" > "$LAST_CLIP_FILE"

              while [ -f /data/local/tmp/hyperdl.pid ]; do
                DL_PID=$(cat /data/local/tmp/hyperdl.pid 2>/dev/null)
                if [ -n "$DL_PID" ] && kill -0 "$DL_PID" 2>/dev/null; then
                  sleep 2
                else
                  rm -f /data/local/tmp/hyperdl.pid
                  break
                fi
              done

              BRIDGE="$(find_bridge)"
              if [ -n "$BRIDGE" ]; then
                _js="{\"status\":\"resolving\",\"percent\":0,\"title\":\"Clipboard auto-download\",\"url\":\"$CLEAN_URL\",\"fmt\":\"video\"}"
                for _f in /data/local/tmp/hyperdl_status.json /data/adb/hyperdl/active_task.json; do
                  printf '%s' "$_js" > "$_f" 2>/dev/null && chmod 666 "$_f" 2>/dev/null || true
                done
                "$BRIDGE" download "$CLEAN_URL" video >/dev/null 2>&1
              fi
            fi
          else
            if [ -n "$LAST_PROCESSED_URL" ]; then
              LAST_PROCESSED_URL=""
            fi
          fi
        fi
      done
      rm -f "$PID_FILE"
    ) </dev/null >/dev/null 2>&1 &

    echo $! > "$PID_FILE"
    chmod 666 "$PID_FILE" 2>/dev/null || true
    ;;

  stop)
    if [ -f "$PID_FILE" ]; then
      OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
      if [ -n "$OLD_PID" ]; then
        kill -9 "$OLD_PID" 2>/dev/null || true
      fi
      rm -f "$PID_FILE"
    fi
    ;;

  status)
    if [ -f "$PID_FILE" ]; then
      OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
      if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "running (PID $OLD_PID)"
        exit 0
      fi
    fi
    echo "stopped"
    exit 1
    ;;

  restart)
    sh "$0" stop
    sleep 1
    sh "$0" start
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
